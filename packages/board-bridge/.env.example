BRIDGE_APP_URL=http://localhost:3001
# Configure a Miro app with boards:read and boards:write.
# Register http://localhost:3001/api/auth/callback as its redirect URI.
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
# Optional: personal Miro developer token for local, single-user testing.
MIRO_ACCESS_TOKEN=
# Optional: enables reading a FigJam board link instead of uploading plugin JSON.
FIGMA_ACCESS_TOKEN=
# Set a stable random secret before hosting. Locally a key is generated in .data.
BRIDGE_SECRET=
# Web app and worker MUST point at the same absolute directory if overridden.
BRIDGE_DATA_DIR=

# Comfy Platform key from platform.comfy.org (SF Build Night workspace). 402 means add credits.
COMFY_API_KEY=
# Workflow backend: empty = Comfy Cloud. http://127.0.0.1:8189 = local ComfyUI + comfy-api-proxy, or your Runpod URL.
COMFY_BASE_URL=
# How long the UI waits before saying "still running" (it keeps polling the same job, never resubmits).
GENERATION_WAIT_TIMEOUT_SECONDS=660
# Where job records, uploads and outputs live locally.
DATA_ROOT=var
# live | demo. demo serves bundled examples and never calls Comfy. Default: demo on Vercel, live elsewhere.
GENERATION_MODE=

{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "input.png" },
    "_meta": { "title": "Input product photo" }
  },
  "2": {
    "class_type": "BiRefNetRMBG",
    "inputs": {
      "image": ["1", 0],
      "model": "BiRefNet-general",
      "mask_blur": 0,
      "mask_offset": 0,
      "invert_output": false,
      "refine_foreground": true,
      "background": "Alpha",
      "background_color": "#222222"
    },
    "_meta": { "title": "BiRefNet background removal" }
  },
  "3": {
    "class_type": "SaveImage",
    "inputs": { "images": ["2", 0], "filename_prefix": "cutout" },
    "_meta": { "title": "Save cutout" }
  }
}
